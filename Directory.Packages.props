<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia (aligned to the Semi.Avalonia target patch so the theme,
         data-grid and control stack share one version; DataGrid has no 12.1.1) -->
    <PackageVersion Include="Avalonia" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <!-- Semi.Avalonia theme -->
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageVersion Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    <!-- MVVM / DI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <!-- Dragged in transitively by AvaloniaUI.DiagnosticsSupport; pinned to the
         10.x line so the graph does not mix .NET 8 and .NET 10 dependency streams. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- Torrent -->
    <PackageVersion Include="MonoTorrent" Version="3.0.2" />
    <!-- Session-bus access for the Linux taskbar (Unity LauncherEntry) progress
         signal; pinned to the version Avalonia.FreeDesktop already pulls in. -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <!-- Storage (SQLite instance metadata) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Design-time only; powers `dotnet ef` migrations, never ships in App (PrivateAssets=All) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- Native SQLite runtime, referenced by the App entry point + test projects
         (auto-added by the EF tools; needed to load the provider binaries). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
    <!-- Appium .NET client for the WinAppDriver-based UI tests. 4.x is the last
         line that speaks WinAppDriver's legacy JSON Wire Protocol directly
         (5.x is W3C-only and needs a full Appium server in between). -->
    <PackageVersion Include="Appium.WebDriver" Version="4.4.5" />
  </ItemGroup>
</Project>
