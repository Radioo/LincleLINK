<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tree="using:LincleLINK.App.ViewModels.FileTree"
             x:Class="LincleLINK.App.Views.FileTreeView"
             x:DataType="tree:FileTreeViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.Folder">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Preview of Pending changes (plan 16 D6, D7): what stays as it is steps
             back, what leaves is struck through, what was unticked is italic. -->
        <Style Selector="TextBlock.Dimmed">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="TextBlock.Removed">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource LLDanger}" />
        </Style>
        <Style Selector="TextBlock.Collision">
            <Setter Property="Foreground" Value="{DynamicResource LLDanger}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.Excluded">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.Badge">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.Badge > TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <!-- Flattened tree (plan 16 D11): every visible file or folder is one row of a
         virtualizing ListBox, indented by its depth. Rows share one height so the
         virtualizing panel never has to measure what is off screen. -->
    <ListBox x:Name="TreeList"
             ItemsSource="{Binding Rows}"
             SelectionMode="Multiple"
             KeyDown="OnListKeyDown"
             DoubleTapped="OnListDoubleTapped">
        <ListBox.Styles>
            <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="26" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="tree:FileTreeRow">
                <Grid ColumnDefinitions="Auto,18,Auto,*,Auto" ColumnSpacing="4" Background="Transparent"
                      ToolTip.Tip="{Binding Detail}">
                    <Border Grid.Column="0" Width="{Binding Indent}" />
                    <Button Grid.Column="1" Padding="0" MinHeight="0" MinWidth="0"
                            Width="18" Height="18" Focusable="False"
                            Background="Transparent" BorderThickness="0"
                            IsVisible="{Binding IsDirectory}"
                            Click="OnExpanderClick">
                        <Panel>
                            <TextBlock Text="▸" FontSize="11" IsVisible="{Binding !IsExpanded}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="▾" FontSize="11" IsVisible="{Binding IsExpanded}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </Button>
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Classes.Folder="{Binding IsDirectory}"
                               Classes.Dimmed="{Binding IsDimmed}"
                               Classes.Removed="{Binding IsRemoved}"
                               Classes.Excluded="{Binding IsExcluded}"
                               Classes.Collision="{Binding IsCollision}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLDanger}" IsVisible="{Binding IsCollision}"
                                ToolTip.Tip="A file and a folder would share this name - untick or remove one of them">
                            <TextBlock Text="name clash" Foreground="{DynamicResource LLDanger}" />
                        </Border>
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLSuccess}" IsVisible="{Binding IsAdded}">
                            <TextBlock Text="new" Foreground="{DynamicResource LLSuccess}" />
                        </Border>
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLWarning}" IsVisible="{Binding IsReplaced}">
                            <TextBlock Text="replaced" Foreground="{DynamicResource LLWarning}" />
                        </Border>
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLHairline}" IsVisible="{Binding IsIdentical}"
                                ToolTip.Tip="The dropped file is the same as the one in this entry, so nothing changes">
                            <TextBlock Text="identical" Opacity="0.6" />
                        </Border>
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLHairline}" IsVisible="{Binding IsChecking}"
                                ToolTip.Tip="Replaces a file of this entry if its content differs - known once it is hashed">
                            <TextBlock Text="checking" Opacity="0.6" />
                        </Border>
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLDanger}" IsVisible="{Binding IsRemoved}">
                            <TextBlock Text="removed" Foreground="{DynamicResource LLDanger}" />
                        </Border>
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLHairline}" IsVisible="{Binding IsExcluded}"
                                ToolTip.Tip="The dropped content at this path is left out">
                            <TextBlock Text="unticked" Opacity="0.6" />
                        </Border>
                        <Border Classes="Badge" BorderBrush="{DynamicResource LLWarning}"
                                IsVisible="{Binding OverridesEarlierSource}"
                                ToolTip.Tip="An earlier source has this file too - the later source wins">
                            <TextBlock Text="in 2+ sources" Foreground="{DynamicResource LLWarning}" />
                        </Border>
                        <Border Classes="Badge" Background="{DynamicResource LLAccentSoft}" BorderThickness="0"
                                IsVisible="{Binding HasChangeCount}">
                            <TextBlock Text="{Binding ChangeCount, StringFormat='{}{0} changes'}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" Margin="12,0,4,0" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
