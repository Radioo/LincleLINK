<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LincleLINK.App.ViewModels"
             xmlns:behaviors="using:LincleLINK.App.Behaviors"
             x:Class="LincleLINK.App.Views.AddInstanceWindow"
             x:DataType="vm:AddInstanceViewModel">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Instance name" />
            <TextBox Text="{Binding InstanceName, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0">
            <TextBlock Text="Data path" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding DataPath, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="24" Margin="0,12,0,0">
            <RadioButton Content="Copy files" GroupName="mode" IsChecked="{Binding IsCopyChecked, Mode=TwoWay}" />
            <RadioButton Content="Move files" GroupName="mode" IsChecked="{Binding IsMoveChecked, Mode=TwoWay}" />
        </StackPanel>

        <Button Grid.Row="3" Content="Create instance" Command="{Binding MakeInstanceCommand}" Margin="0,12,0,0" />

        <ListBox Grid.Row="4" Margin="0,12,0,0"
                 ItemsSource="{Binding LogLines}"
                 behaviors:AutoScrollBehavior.AutoScrollToEnd="True" />

        <ProgressBar Grid.Row="5" Value="{Binding Progress}" Minimum="0" Maximum="100" Margin="0,12,0,0" />

    </Grid>
</UserControl>
