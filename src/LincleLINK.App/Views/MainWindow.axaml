<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LincleLINK.App.ViewModels"
        xmlns:domain="using:LincleLINK.Core.Domain"
        xmlns:logos="using:LincleLINK.App.Logos"
        xmlns:converters="using:LincleLINK.App.Converters"
        xmlns:behaviors="using:LincleLINK.App.Behaviors"
        x:Class="LincleLINK.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/LL_logo.ico"
        Title="LincleLINK &quot;It never ends&quot;"
        Width="1120" Height="700" MinWidth="840" MinHeight="540">

    <!-- Hidden until a DataContext exists: the first-run flow shows this window
         (as a dialog owner) before the view model can be constructed, and unbound
         page-visibility bindings would render every page stacked. -->
    <Grid RowDefinitions="*,Auto,Auto"
          IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">

        <!-- ═════════ shell: sidebar | page area (plan 15 D1) ═════════ -->
        <Panel Grid.Row="0">
            <Grid ColumnDefinitions="200,*">

                <!-- sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource LLSidebar}"
                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*,Auto" Margin="10,12,10,12">

                        <ListBox Grid.Row="0"
                                 SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="CornerRadius" Value="7" />
                                    <Setter Property="Padding" Value="10,7" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListBox.Styles>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="▤" Width="16" TextAlignment="Center" />
                                    <TextBlock Text="Library" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⇣" Width="16" TextAlignment="Center" />
                                    <TextBlock Text="Torrent pre-fill" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="⚙" Width="16" TextAlignment="Center" />
                                    <TextBlock Text="Settings" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <!-- storage card: the product's brag, visible on every page -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource LLSurface}"
                                BorderBrush="{DynamicResource LLHairline}" BorderThickness="1"
                                CornerRadius="8" Padding="11,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Savings, StringFormat=Saving {0}}"
                                           FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource LLAccentText}" />
                                <!-- MinWidth=0 is load-bearing: the themed ProgressBar template has a
                                     default MinWidth wider than the sidebar card and overflows it. -->
                                <ProgressBar Value="{Binding StorageSharePercent}" Maximum="100"
                                             Height="6" MinHeight="6" MinWidth="0" Margin="0,2,0,2"
                                             HorizontalAlignment="Stretch"
                                             ToolTip.Tip="Storage size as a share of what the library would occupy un-deduplicated" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Storage" Opacity="0.6" FontSize="11.5" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DbSize}" FontSize="11.5" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Library" Opacity="0.6" FontSize="11.5" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LibrarySize}" FontSize="11.5" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Free space" Opacity="0.6" FontSize="11.5" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FreeSpace}" FontSize="11.5" />
                                </Grid>
                                <Button Content="Clean up storage..." FontSize="11.5" Padding="8,4"
                                        HorizontalAlignment="Stretch" Margin="0,4,0,0"
                                        Command="{Binding CheckUnusedCommand}"
                                        ToolTip.Tip="Find and delete storage files that no longer belong to any library entry" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- page area -->
                <Panel Grid.Column="1" Margin="16,12,16,8">

                    <!-- ═════ Library page (plan 15 D2) ═════ -->
                    <Grid IsVisible="{Binding IsLibraryPage}" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="Library" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Instances.Count, StringFormat={}{0} entries}"
                                       Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" MinWidth="170" PlaceholderText="Filter entries..."
                                     Text="{Binding FilterText, Mode=TwoWay}" />
                            <Button Grid.Column="3" Padding="8,4" Background="Transparent" BorderThickness="0"
                                    Command="{Binding ToggleViewModeCommand}"
                                    ToolTip.Tip="Switch between list and grid view">
                                <Panel>
                                    <TextBlock Text="☰" FontSize="14" IsVisible="{Binding !IsGridView}" />
                                    <TextBlock Text="⊞" FontSize="14" IsVisible="{Binding IsGridView}" />
                                </Panel>
                            </Button>
                            <Button Grid.Column="4" Classes="Primary" Content="＋ Add folder..."
                                    Command="{Binding OpenAddInstanceCommand}"
                                    ToolTip.Tip="Register a folder as a library entry and absorb its files into storage" />
                        </Grid>

                        <Panel Grid.Row="1">
                            <Grid ColumnDefinitions="*,250" ColumnSpacing="12" IsVisible="{Binding !!Instances.Count}">
                                <DataGrid Grid.Column="0"
                                          ItemsSource="{Binding FilteredInstances}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          GridLinesVisibility="None"
                                          SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                          IsVisible="{Binding !IsGridView}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu x:DataType="vm:MainViewModel">
                                            <MenuItem Header="Deploy to folder..." Command="{Binding LinkFilesCommand}" />
                                            <MenuItem Header="Export storage files..." Command="{Binding CopyHashedCommand}" />
                                            <Separator />
                                            <MenuItem Header="Remove from library" Command="{Binding DeleteInstanceCommand}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn x:DataType="domain:InstanceListEntry"
                                                                Width="44" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Image Width="32" Height="32" Stretch="Uniform"
                                                           Source="{Binding LogoUri, Converter={StaticResource LogoSourceConverter}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Name" Binding="{Binding InstanceName}" Width="3*" />
                                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="1*" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding TotalFileSizeString}" Width="1*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ScrollViewer Grid.Column="0" IsVisible="{Binding IsGridView}">
                                    <ItemsControl ItemsSource="{Binding FilteredInstances}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="domain:InstanceListEntry">
                                                <Border Width="150" Height="140" Margin="4" Padding="10"
                                                        Background="{DynamicResource LLCard}"
                                                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1"
                                                        CornerRadius="8" Cursor="Hand"
                                                        PointerPressed="OnGridItemClicked">
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Width="64" Height="64" Stretch="Uniform"
                                                               Source="{Binding LogoUri, Converter={StaticResource LogoSourceConverter}}" />
                                                        <TextBlock Text="{Binding InstanceName}" TextAlignment="Center"
                                                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                   FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- inspector -->
                                <Panel Grid.Column="1">
                                    <Border Background="{DynamicResource LLCard}"
                                            BorderBrush="{DynamicResource LLHairline}" BorderThickness="1"
                                            CornerRadius="8" Padding="14" VerticalAlignment="Top"
                                            IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel Spacing="10">
                                            <Panel HorizontalAlignment="Center">
                                                <Image Width="100" Height="60" Stretch="Uniform"
                                                       Source="{Binding SelectedLogoUri, Converter={StaticResource LogoSourceConverter}}"
                                                       IsVisible="{Binding SelectedLogoUri, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <Border Width="100" Height="60"
                                                        Background="{DynamicResource LLSurface}"
                                                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1"
                                                        CornerRadius="4" Opacity="0.3"
                                                        IsVisible="{Binding SelectedLogoUri, Converter={x:Static ObjectConverters.IsNull}}" />
                                            </Panel>
                                            <Button HorizontalAlignment="Center" FontSize="11" Padding="6,2"
                                                    Content="Change logo..."
                                                    Command="{Binding OpenLogoPickerCommand}" />
                                            <TextBlock Text="{Binding SelectedInstance.InstanceName}"
                                                       FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Files" Opacity="0.6" FontSize="12" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedInstance.FileCount}" FontSize="12" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Size when deployed" Opacity="0.6" FontSize="12" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInstance.TotalFileSizeString}" FontSize="12" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Unique to this entry" Opacity="0.6" FontSize="12"
                                                           ToolTip.Tip="Bytes in storage referenced by no other entry - what a removal plus storage cleanup would free" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedUniqueSizeText}" FontSize="12" />
                                            </Grid>
                                            <Button Classes="Primary" HorizontalAlignment="Stretch"
                                                    Content="Deploy to folder..." Command="{Binding LinkFilesCommand}"
                                                    ToolTip.Tip="Recreate this entry anywhere on the same drive using hard links - no extra disk space" />
                                            <Button HorizontalAlignment="Stretch"
                                                    Content="Export storage files..." Command="{Binding CopyHashedCommand}"
                                                    ToolTip.Tip="Copy this entry's files out of storage under their hashed names" />
                                            <Button Classes="Danger" HorizontalAlignment="Stretch"
                                                    Content="Remove from library" Command="{Binding DeleteInstanceCommand}"
                                                    ToolTip.Tip="Forget this entry - its files stay in storage and deployed folders are untouched" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Select an entry to see its details."
                                               Opacity="0.5" FontSize="12" TextWrapping="Wrap"
                                               Margin="8,12,0,0"
                                               IsVisible="{Binding SelectedInstance, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Panel>
                            </Grid>

                            <!-- empty state with the model diagram -->
                            <StackPanel IsVisible="{Binding !Instances.Count}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Spacing="12" MaxWidth="460">
                                <TextBlock Text="Your library is empty" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" TextAlignment="Center" FontSize="13"
                                           Text="Add a game's data folder to store it deduplicated - identical files across versions are stored only once. You can then deploy any entry to any folder on the same drive, using no extra disk space." />
                                <Button Content="＋ Add your first folder" Classes="Primary"
                                        Command="{Binding OpenAddInstanceCommand}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </Grid>

                    <!-- ═════ Torrent pre-fill page (plan 15 D6) ═════ -->
                    <ScrollViewer IsVisible="{Binding IsTorrentPage}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Torrent pre-fill" FontSize="19" FontWeight="Bold" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12.5"
                                           Text="Already have most of a torrent's files in your library? Link them into the download folder first - your torrent client then only fetches what's missing, and verified links won't be overwritten." />
                            </StackPanel>

                            <!-- inputs card -->
                            <Border Background="{DynamicResource LLCard}" BorderBrush="{DynamicResource LLHairline}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Library entry to pre-fill from" FontSize="12" Opacity="0.7" />
                                        <ComboBox ItemsSource="{Binding Instances}"
                                                  SelectedItem="{Binding TorrentCheck.TorrentInstance, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="domain:InstanceListEntry">
                                                    <TextBlock Text="{Binding InstanceName}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Torrent file" FontSize="12" Opacity="0.7" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding TorrentCheck.TorrentFilePath, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Content="Browse..." Command="{Binding TorrentCheck.BrowseTorrentFileCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Data folder inside the torrent" FontSize="12" Opacity="0.7" />
                                        <TextBox Text="{Binding TorrentCheck.RelativePath, Mode=TwoWay}" PlaceholderText="contents\data"
                                                 ToolTip.Tip="Where the data folder sits within the torrent's structure - usually contents\data" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Download folder (point your torrent client here)" FontSize="12" Opacity="0.7" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding TorrentCheck.TorrentDownloadPath, Mode=TwoWay}" />
                                            <Button Grid.Column="1" Content="Browse..." Command="{Binding TorrentCheck.BrowseTorrentDlPathCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- stepper -->
                            <Border Background="{DynamicResource LLCard}" BorderBrush="{DynamicResource LLHairline}"
                                    BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid ColumnDefinitions="26,170,*" ColumnSpacing="12"
                                      RowDefinitions="Auto,14,Auto,14,Auto">

                                    <!-- step 1 -->
                                    <Panel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLAccentSoft}"
                                                IsVisible="{Binding !TorrentCheck.FilesMatched}">
                                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LLAccentText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLSuccess}"
                                                IsVisible="{Binding TorrentCheck.FilesMatched}">
                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Panel>
                                    <Button Grid.Row="0" Grid.Column="1" Content="Match files" HorizontalAlignment="Stretch"
                                            Command="{Binding TorrentCheck.CheckFilesCommand}"
                                            ToolTip.Tip="Quick name and size comparison between the torrent and the selected entry" />
                                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TorrentCheck.MatchSummary}" FontSize="12" Opacity="0.85"
                                                   IsVisible="{Binding TorrentCheck.MatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Grid.Column="0" Width="2" Background="{DynamicResource LLHairline}" HorizontalAlignment="Center" />

                                    <!-- step 2 -->
                                    <Panel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLAccentSoft}"
                                                IsVisible="{Binding !TorrentCheck.PiecesVerified}">
                                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LLAccentText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLSuccess}"
                                                IsVisible="{Binding TorrentCheck.PiecesVerified}">
                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Panel>
                                    <Button Grid.Row="2" Grid.Column="1" Content="Verify pieces" HorizontalAlignment="Stretch"
                                            Command="{Binding TorrentCheck.CheckPiecesCommand}"
                                            ToolTip.Tip="Byte-exact piece check - only fully verified files get linked, so nothing is overwritten" />
                                    <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TorrentCheck.VerifySummary}" FontSize="12" Opacity="0.85"
                                                   IsVisible="{Binding TorrentCheck.VerifySummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding TorrentCheck.VerifyHint}" FontSize="12" Opacity="0.5"
                                                   IsVisible="{Binding TorrentCheck.VerifyHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Grid.Column="0" Width="2" Background="{DynamicResource LLHairline}" HorizontalAlignment="Center" />

                                    <!-- step 3 -->
                                    <Panel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLAccentSoft}"
                                                IsVisible="{Binding TorrentCheck.LinkSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LLAccentText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLSuccess}"
                                                IsVisible="{Binding TorrentCheck.LinkSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Panel>
                                    <Button Grid.Row="4" Grid.Column="1" Content="{Binding TorrentCheck.LinkButtonText}"
                                            HorizontalAlignment="Stretch" Classes="Primary"
                                            Command="{Binding TorrentCheck.LinkToTorrentCommand}"
                                            ToolTip.Tip="Hard-link every verified file into the download folder" />
                                    <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TorrentCheck.LinkSummary}" FontSize="12" Opacity="0.85"
                                                   IsVisible="{Binding TorrentCheck.LinkSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding TorrentCheck.LinkHint}" FontSize="12" Opacity="0.5"
                                                   IsVisible="{Binding TorrentCheck.LinkHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Expander Header="Matched files">
                                <ListBox MaxHeight="180" FontSize="12"
                                         ItemsSource="{Binding TorrentCheck.MatchedFiles}"
                                         behaviors:AutoScrollBehavior.AutoScrollToEnd="True" />
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═════ Settings page (plan 15 D7) ═════ -->
                    <ScrollViewer IsVisible="{Binding IsSettingsPage}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Settings" FontSize="19" FontWeight="Bold" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource LLCard}"
                                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="Theme follows your system by default" Opacity="0.6" FontSize="11.5" />
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <RadioButton Content="Light" GroupName="theme" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                                            <RadioButton Content="Dark" GroupName="theme" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                                            <RadioButton Content="System" GroupName="theme" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource LLCard}"
                                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Performance" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="Worker threads for hashing and storage cleanup" Opacity="0.6" FontSize="11.5" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Slider Grid.Column="0" Minimum="1" Maximum="{Binding MaxThreadCount}"
                                                    Value="{Binding ThreadCount, Mode=TwoWay}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ThreadCount}" VerticalAlignment="Center"
                                                       MinWidth="24" TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource LLCard}"
                                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Data location" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="Where storage (db) and the library database live" Opacity="0.6" FontSize="11.5" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Grid.Column="0" Text="{Binding DataDirectory}" IsReadOnly="True" />
                                            <Button Grid.Column="1" Content="Change..." Command="{Binding ChangeDataDirectoryCommand}" />
                                        </Grid>
                                        <TextBlock Text="Takes effect after restarting LincleLINK"
                                                   Foreground="{DynamicResource LLWarning}" FontSize="11.5"
                                                   IsVisible="{Binding DataDirectoryChangePending}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource LLCard}"
                                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Import from LincleLINK v1" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="Bring in a legacy DBInfo.xml library list" Opacity="0.6" FontSize="11.5" />
                                        <Button Content="Import DBInfo.xml..." Command="{Binding ImportLegacyCommand}"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Grid>

            <!-- ═════ slide-over add flow (plan 15 D4) ═════ -->
            <Panel IsVisible="{Binding IsAddPanelOpen}">
                <Border Background="{DynamicResource LLVeil}" />
                <Border HorizontalAlignment="Right" Width="400"
                        Background="{DynamicResource LLSurface}"
                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1,0,0,0"
                        BoxShadow="-6 0 24 0 #40000000">
                    <ContentControl Content="{Binding AddInstance}" />
                </Border>
            </Panel>

            <Border Background="{DynamicResource LLVeil}" IsVisible="{Binding IsLogoPickerOpen}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" Height="420"
                    Background="{DynamicResource LLSurface}"
                    BorderBrush="{DynamicResource LLHairline}" BorderThickness="1"
                    CornerRadius="10" BoxShadow="0 0 24 0 #40000000" Padding="14"
                    IsVisible="{Binding IsLogoPickerOpen}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Choose a logo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="Reset to auto" FontSize="11" Padding="6,2"
                                Command="{Binding SetCustomLogoCommand}"
                                CommandParameter="{x:Null}" />
                        <Button Content="Add custom image..." FontSize="11" Padding="6,2"
                                Command="{Binding SetCustomImageCommand}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding AvailableLogos}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="logos:LogoEntry">
                                    <Border Width="72" Height="72" Margin="4" Padding="4"
                                            Background="{DynamicResource LLCard}"
                                            BorderBrush="{DynamicResource LLHairline}" BorderThickness="1"
                                            CornerRadius="6" Cursor="Hand"
                                            ToolTip.Tip="{Binding DisplayName}"
                                            PointerPressed="OnLogoClicked">
                                        <Image Stretch="Uniform" Source="{Binding AssetPath, Converter={StaticResource LogoSourceConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Row="3" Content="Close" FontSize="11" Padding="8,3"
                            HorizontalAlignment="Right" Margin="0,8,0,0"
                            Command="{Binding CloseLogoPickerCommand}" />
                </Grid>
            </Border>
        </Panel>

        <!-- ═════ log drawer ═════ -->
        <Border Grid.Row="1" IsVisible="{Binding IsLogOpen}"
                BorderBrush="{DynamicResource LLHairline}" BorderThickness="0,1,0,0">
            <ListBox Height="160" FontSize="12"
                     ItemsSource="{Binding LogLines}"
                     behaviors:AutoScrollBehavior.AutoScrollToEnd="True" />
        </Border>

        <!-- ═════ activity bar (plan 15 D5) ═════ -->
        <Border Grid.Row="2" Background="{DynamicResource LLSidebar}"
                BorderBrush="{DynamicResource LLHairline}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="12,5">

                <Panel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Prefix trimming: long per-file paths keep their tail (the file
                         being worked on) visible; the ellipsis eats the middle. -->
                    <TextBlock Text="{Binding StatusLine}" FontSize="12" Opacity="0.75"
                               TextTrimming="PrefixCharacterEllipsis" IsVisible="{Binding IsBusy}" />
                    <Panel IsVisible="{Binding !IsBusy}">
                        <TextBlock Text="{Binding LastOutcome}" FontSize="12" Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !LastOutcomeIsWarning}" />
                        <TextBlock Text="{Binding LastOutcome}" FontSize="12"
                                   Foreground="{DynamicResource LLWarning}"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding LastOutcomeIsWarning}" />
                    </Panel>
                </Panel>

                <ProgressBar Grid.Column="1" Width="170" Height="6" MinHeight="6"
                             Value="{Binding Progress}" Minimum="0" Maximum="100"
                             VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
                <TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat={}{0:0}%}"
                           FontSize="12" Opacity="0.7" VerticalAlignment="Center" MinWidth="34"
                           TextAlignment="Right" IsVisible="{Binding IsBusy}" />
                <Button Grid.Column="3" Content="Cancel" FontSize="12" Padding="10,3"
                        Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}" />
                <Button Grid.Column="4" Content="Activity log ▸" FontSize="12" Padding="10,3"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource LLAccentText}" FontWeight="SemiBold"
                        Command="{Binding ToggleLogCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
