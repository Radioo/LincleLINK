<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LincleLINK.App.ViewModels"
        xmlns:domain="using:LincleLINK.Core.Domain"
        xmlns:behaviors="using:LincleLINK.App.Behaviors"
        x:Class="LincleLINK.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/LL_logo.ico"
        Title="LincleLINK &quot;It never ends&quot;"
        Width="860" Height="520">

    <Grid Margin="5" RowDefinitions="4*,5,1*,Auto">

        <TabControl Grid.Row="0">

            <TabItem Header="Instances">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,6,0,8">
                        <Button Content="Add instance" Command="{Binding OpenAddInstanceCommand}" />
                        <Button Content="Link files" Command="{Binding LinkFilesCommand}" />
                        <Button Content="Copy hashed files" Command="{Binding CopyHashedCommand}" />
                        <Button Content="Check for unused files" Command="{Binding CheckUnusedCommand}" />
                        <Button Content="Delete instance" Command="{Binding DeleteInstanceCommand}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Instances}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              SelectedItem="{Binding SelectedInstance, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding InstanceName}" Width="3*" />
                            <DataGridTextColumn Header="File count" Binding="{Binding FileCount}" Width="1*" />
                            <DataGridTextColumn Header="Instance size" Binding="{Binding TotalFileSizeString}" Width="1*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Link to torrent">
                <Grid Margin="0,4" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="6">

                    <TextBlock Grid.Row="0" Text="Instance to link from" />
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding Instances}"
                              SelectedItem="{Binding TorrentCheck.TorrentInstance, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:InstanceListEntry">
                                <TextBlock Text="{Binding InstanceName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="Torrent file path" />
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding TorrentCheck.TorrentFilePath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding TorrentCheck.BrowseTorrentFileCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="Torrent relative data path" />
                    <TextBox Grid.Row="5" Text="{Binding TorrentCheck.RelativePath, Mode=TwoWay}" PlaceholderText="contents\data" />

                    <TextBlock Grid.Row="6" Text="Torrent download &amp; link target location" />
                    <Grid Grid.Row="7" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding TorrentCheck.TorrentDownloadPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding TorrentCheck.BrowseTorrentDlPathCommand}" />
                    </Grid>

                    <Grid Grid.Row="8" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="Check files" Command="{Binding TorrentCheck.CheckFilesCommand}" />
                        <Button Grid.Column="1" Content="Check pieces" Command="{Binding TorrentCheck.CheckPiecesCommand}" />
                        <Button Grid.Column="2" Content="Start linking" Command="{Binding TorrentCheck.LinkToTorrentCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="9" Text="Matched instance files" />
                    <ListBox Grid.Row="10"
                             ItemsSource="{Binding TorrentCheck.MatchedFiles}"
                             behaviors:AutoScrollBehavior.AutoScrollToEnd="True" />

                </Grid>
            </TabItem>

            <TabItem Header="Other">
                <StackPanel Spacing="8" Margin="8" Width="360" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DbSize, StringFormat=db folder size: {0}}" />
                    <TextBlock Text="{Binding Savings, StringFormat=You are saving: {0}}" />
                    <TextBlock Text="{Binding FreeSpace, StringFormat=Free drive space: {0}}" />
                    <Button Content="Import DBInfo.xml" Command="{Binding ImportLegacyCommand}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                        <RadioButton Content="Light" GroupName="theme" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Content="Dark" GroupName="theme" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                        <RadioButton Content="System" GroupName="theme" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Add instance hash threads" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Slider Grid.Column="0"
                                    Minimum="1"
                                    Maximum="{Binding MaxThreadCount}"
                                    Value="{Binding ThreadCount, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{Binding ThreadCount}" VerticalAlignment="Center" MinWidth="24" TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </TabItem>

        </TabControl>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

        <ListBox Grid.Row="2" Margin="0,4"
                 ItemsSource="{Binding LogLines}"
                 behaviors:AutoScrollBehavior.AutoScrollToEnd="True" />

        <ProgressBar Grid.Row="3" Value="{Binding Progress}" Minimum="0" Maximum="100" />

    </Grid>

</Window>
