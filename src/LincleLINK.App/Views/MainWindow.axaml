<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LincleLINK.App.ViewModels"
        xmlns:views="using:LincleLINK.App.Views"
        xmlns:behaviors="using:LincleLINK.App.Behaviors"
        x:Class="LincleLINK.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/LL_logo.ico"
        Title="LincleLINK &quot;It never ends&quot;"
        Width="1120" Height="700" MinWidth="840" MinHeight="540">

    <!-- Hidden until a DataContext exists: the first-run flow shows this window
         (as a dialog owner) before the view model can be constructed, and unbound
         page-visibility bindings would render every page stacked. -->
    <Grid RowDefinitions="*,Auto,Auto"
          IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">

        <!-- ═════════ shell: sidebar | page area (plan 15 D1) ═════════ -->
        <Panel Grid.Row="0">
            <Grid ColumnDefinitions="200,*">

                <views:Sidebar Grid.Column="0" />

                <!-- page area -->
                <Panel Grid.Column="1" Margin="16,12,16,8">
                    <views:LibraryPage IsVisible="{Binding IsLibraryPage}" />
                    <views:TorrentPage IsVisible="{Binding IsTorrentPage}" />
                    <views:SettingsPage IsVisible="{Binding IsSettingsPage}" />
                </Panel>
            </Grid>

            <!-- ═════ slide-over add flow (plan 15 D4) ═════ -->
            <Panel IsVisible="{Binding IsAddPanelOpen}">
                <Border Background="{DynamicResource LLVeil}" />
                <Border HorizontalAlignment="Right" Width="400"
                        Background="{DynamicResource LLSurface}"
                        BorderBrush="{DynamicResource LLHairline}" BorderThickness="1,0,0,0"
                        BoxShadow="-6 0 24 0 #40000000">
                    <ContentControl Content="{Binding AddInstance}" />
                </Border>
            </Panel>

            <!-- ═════ logo picker overlay ═════ -->
            <views:LogoPicker IsVisible="{Binding IsLogoPickerOpen}" />
        </Panel>

        <!-- ═════ log drawer ═════ -->
        <Border Grid.Row="1" IsVisible="{Binding IsLogOpen}"
                BorderBrush="{DynamicResource LLHairline}" BorderThickness="0,1,0,0">
            <ListBox Height="160" FontSize="12"
                     ItemsSource="{Binding LogLines}"
                     behaviors:AutoScrollBehavior.AutoScrollToEnd="True" />
        </Border>

        <!-- ═════ activity bar (plan 15 D5) ═════ -->
        <views:ActivityBar Grid.Row="2" />
    </Grid>
</Window>
