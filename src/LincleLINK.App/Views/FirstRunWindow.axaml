<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LincleLINK.App.ViewModels"
             x:Class="LincleLINK.App.Views.FirstRunWindow"
             x:DataType="vm:FirstRunViewModel">
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="Welcome to LincleLINK" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="This looks like the first launch. Choose the data directory that contains (or will contain) your db/ and instance/ folders." TextWrapping="Wrap" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" />

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Text="Data directory" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding DataDirectory, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseCommand}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="24">
            <TextBlock Text="Theme" VerticalAlignment="Center" />
            <RadioButton Content="Light" GroupName="theme" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
            <RadioButton Content="Dark" GroupName="theme" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
        </StackPanel>

        <Button Content="Use this directory" Command="{Binding ConfirmCommand}" HorizontalAlignment="Right" MinWidth="160" />
    </StackPanel>
</UserControl>
