<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LincleLINK.App.ViewModels"
             x:Class="LincleLINK.App.Views.ActivityBar"
             x:DataType="vm:MainViewModel">
    <Border Background="{DynamicResource LLSidebar}"
            BorderBrush="{DynamicResource LLHairline}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10" Margin="12,5">

            <ProgressBar Grid.Column="0" Width="170" Height="6" MinHeight="6"
                         Value="{Binding Progress}" Minimum="0" Maximum="100"
                         VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0}%}"
                       FontSize="12" Opacity="0.7" VerticalAlignment="Center" MinWidth="34"
                       TextAlignment="Right" IsVisible="{Binding IsBusy}" />
            <Button Grid.Column="2" Content="Cancel" FontSize="12" Padding="10,3"
                    Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}" />
        </Grid>
    </Border>
</UserControl>
