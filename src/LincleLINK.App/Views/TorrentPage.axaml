<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LincleLINK.App.ViewModels"
             xmlns:domain="using:LincleLINK.Core.Domain"
             xmlns:behaviors="using:LincleLINK.App.Behaviors"
             x:Class="LincleLINK.App.Views.TorrentPage"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="Torrent pre-fill" FontSize="19" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12.5"
                           Text="Already have most of a torrent's files in your library? Link them into the download folder first - your torrent client then only fetches what's missing, and verified links won't be overwritten." />
            </StackPanel>

            <!-- inputs card -->
            <Border Background="{DynamicResource LLCard}" BorderBrush="{DynamicResource LLHairline}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="Library entry to pre-fill from" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding TorrentCheck.TorrentInstance, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="domain:InstanceListEntry">
                                    <TextBlock Text="{Binding InstanceName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <TextBlock Text="Torrent file" FontSize="12" Opacity="0.7" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding TorrentCheck.TorrentFilePath, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding TorrentCheck.BrowseTorrentFileCommand}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                        <TextBlock Text="Data folder inside the torrent" FontSize="12" Opacity="0.7" />
                        <TextBox Text="{Binding TorrentCheck.RelativePath, Mode=TwoWay}" PlaceholderText="contents\data"
                                 ToolTip.Tip="Where the data folder sits within the torrent's structure - usually contents\data" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Text="Download folder (point your torrent client here)" FontSize="12" Opacity="0.7" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0" Text="{Binding TorrentCheck.TorrentDownloadPath, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Browse..." Command="{Binding TorrentCheck.BrowseTorrentDlPathCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- stepper -->
            <Border Background="{DynamicResource LLCard}" BorderBrush="{DynamicResource LLHairline}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid ColumnDefinitions="26,170,*" ColumnSpacing="12"
                      RowDefinitions="Auto,14,Auto,14,Auto">

                    <!-- step 1 -->
                    <Panel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLAccentSoft}"
                                IsVisible="{Binding !TorrentCheck.FilesMatched}">
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LLAccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLSuccess}"
                                IsVisible="{Binding TorrentCheck.FilesMatched}">
                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <Button Grid.Row="0" Grid.Column="1" Content="Match files" HorizontalAlignment="Stretch"
                            Command="{Binding TorrentCheck.CheckFilesCommand}"
                            ToolTip.Tip="Quick name and size comparison between the torrent and the selected entry" />
                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TorrentCheck.MatchSummary}" FontSize="12" Opacity="0.85"
                                   IsVisible="{Binding TorrentCheck.MatchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="0" Width="2" Background="{DynamicResource LLHairline}" HorizontalAlignment="Center" />

                    <!-- step 2 -->
                    <Panel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLAccentSoft}"
                                IsVisible="{Binding !TorrentCheck.PiecesVerified}">
                            <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LLAccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLSuccess}"
                                IsVisible="{Binding TorrentCheck.PiecesVerified}">
                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <Button Grid.Row="2" Grid.Column="1" Content="Verify pieces" HorizontalAlignment="Stretch"
                            Command="{Binding TorrentCheck.CheckPiecesCommand}"
                            ToolTip.Tip="Byte-exact piece check - only fully verified files get linked, so nothing is overwritten" />
                    <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TorrentCheck.VerifySummary}" FontSize="12" Opacity="0.85"
                                   IsVisible="{Binding TorrentCheck.VerifySummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding TorrentCheck.VerifyHint}" FontSize="12" Opacity="0.5"
                                   IsVisible="{Binding TorrentCheck.VerifyHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <Border Grid.Row="3" Grid.Column="0" Width="2" Background="{DynamicResource LLHairline}" HorizontalAlignment="Center" />

                    <!-- step 3 -->
                    <Panel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLAccentSoft}"
                                IsVisible="{Binding TorrentCheck.LinkSummary, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <TextBlock Text="3" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LLAccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource LLSuccess}"
                                IsVisible="{Binding TorrentCheck.LinkSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <Button Grid.Row="4" Grid.Column="1" Content="{Binding TorrentCheck.LinkButtonText}"
                            HorizontalAlignment="Stretch" Classes="Primary"
                            Command="{Binding TorrentCheck.LinkToTorrentCommand}"
                            ToolTip.Tip="Hard-link every verified file into the download folder" />
                    <StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TorrentCheck.LinkSummary}" FontSize="12" Opacity="0.85"
                                   IsVisible="{Binding TorrentCheck.LinkSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding TorrentCheck.LinkHint}" FontSize="12" Opacity="0.5"
                                   IsVisible="{Binding TorrentCheck.LinkHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Header="Matched files">
                <ListBox MaxHeight="180" FontSize="12"
                         ItemsSource="{Binding TorrentCheck.MatchedFiles}"
                         behaviors:AutoScrollBehavior.AutoScrollToEnd="True" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
